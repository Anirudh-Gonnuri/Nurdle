# Normalize line endings: store text as LF in the repo and check it out as LF
# on every platform. Prevents CRLF churn when editing from Windows.
* text=auto eol=lf

# Source and config files
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Binary assets: never diff or normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Collapse lockfile diffs in GitHub PR views
package-lock.json linguist-generated=true -diff
